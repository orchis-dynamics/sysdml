{
	"name": "@sysdml/cli",
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"bin": {
		"sysdml": "./dist/src/index.js"
	},
	"type": "module",
	"exports": {
		"./pipeline": {
			"types": "./dist/src/pipeline.d.ts",
			"default": "./dist/src/pipeline.js"
		},
		"./csv": {
			"types": "./dist/src/csv.d.ts",
			"default": "./dist/src/csv.js"
		}
	},
	"typesVersions": {
		"*": {
			"pipeline": ["./dist/src/pipeline.d.ts"],
			"csv": ["./dist/src/csv.d.ts"]
		}
	},
	"scripts": {
		"clean": "rm -rf dist node_modules",
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@sysdml/contracts": "workspace:*",
		"@sysdml/ir": "workspace:*",
		"@sysdml/parser": "workspace:*",
		"@sysdml/simulator": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"typescript": "^5.4.5",
		"vitest": "^4.1.5"
	}
}
