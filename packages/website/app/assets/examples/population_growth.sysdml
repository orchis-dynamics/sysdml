sfd population_growth

time {
  start: 0
  end: 100
  step: 1
}

stock population {
  init: 1000
}

stock dead_people {
  init: 1000
}

aux immigration_rate = 0.0256

flow immigration {
  from: null
  to: population
  rate: population * immigration_rate
}

aux birth_rate = 0.2

flow births {
  from: null
  to: population
  rate: population * birth_rate
}

aux death_rate = 0.03

flow deaths {
  from: population
  to: dead_people
  rate: population * 0.019
}

stock waterStock {
  init: 10000
}

aux rain_rate = 0.05

flow rain {
  from: null
  to: waterStock
  rate: waterStock * rain_rate
}

aux evaporation_rate = 0.055

flow evaporation {
  from: waterStock
  to: null
  rate: waterStock * evaporation_rate
}

population ->+ births {
  angle: -69
}

birth_rate ->+ births {
  angle: 123
}

population ->+ deaths

immigration_rate ->+ immigration {
  angle: 93
  via: { x: 52, y: -210 }
}

death_rate ->+ deaths

waterStock ->+ evaporation

waterStock ->+ rain

rain_rate ->+ rain

evaporation_rate ->+ evaporation
