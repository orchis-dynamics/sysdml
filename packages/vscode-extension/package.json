{
	"name": "sysdml-vscode",
	"displayName": "SysDML",
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"description": "Language support for SysDML system dynamics models",
	"categories": [
		"Programming Languages"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/orchis-dynamics/sysdml"
	},
	"publisher": "orchis-dynamics",
	"main": "./dist/extension.js",
	"scripts": {
		"clean": "rm -rf dist renderer-dist node_modules *.vsix",
		"typecheck": "tsc --noEmit",
		"build": "pnpm run build:lsp && pnpm run build:renderer && pnpm run build:extension",
		"build:extension": "pnpm run typecheck && node esbuild.js --production",
		"build:dev": "node esbuild.js",
		"watch": "node esbuild.js --watch",
		"package": "pnpm run build && vsce package --no-dependencies",
		"build:lsp": "pnpm --filter @sysdml/lsp-server... build",
		"build:renderer": "pnpm --filter @sysdml/contracts --filter @sysdml/parser --filter @sysdml/ir --filter @sysdml/layout --filter @sysdml/simulator --filter @sysdml/cli build && pnpm --filter @sysdml/renderer build:vscode && rm -rf renderer-dist && cp -R ../renderer/dist-vscode renderer-dist",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@simlin/engine": "workspace:*",
		"@sysdml/cli": "workspace:*",
		"@sysdml/contracts": "workspace:*",
		"@sysdml/lsp-server": "workspace:*",
		"@types/node": "^24.12.4",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^3.9.1",
		"esbuild": "^0.24.0",
		"typescript": "^5.4.5",
		"vitest": "^4.1.5",
		"vscode-languageclient": "^9.0.0"
	},
	"contributes": {
		"languages": [
			{
				"id": "sysdml",
				"aliases": [
					"SysDML",
					"sysdml"
				],
				"extensions": [
					".sysdml"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "sysdml",
				"scopeName": "source.sysdml",
				"path": "./syntaxes/sysdml.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "sysdml.openDiagram",
				"title": "SysDML: Open Diagram",
				"icon": "assets/images/sysdml-logo.svg"
			},
			{
				"command": "sysdml.refreshDiagram",
				"title": "SysDML: Refresh Diagram"
			},
			{
				"command": "sysdml.simulate",
				"title": "SysDML: Simulate",
				"icon": "$(play)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "sysdml.openDiagram",
					"when": "resourceLangId == sysdml",
					"group": "navigation"
				},
				{
					"command": "sysdml.simulate",
					"when": "resourceLangId == sysdml",
					"group": "navigation"
				}
			]
		}
	},
	"activationEvents": [
		"onLanguage:sysdml"
	],
	"icon": "assets/images/sysdml-logo.png",
	"engines": {
		"vscode": "^1.85.0"
	}
}
