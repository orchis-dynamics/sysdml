{
	"comments": {
		"lineComment": {
			"comment": "//",
			"noIndent": true
		},
		"blockComment": ["/*", "*/"]
	},
	"brackets": [
		["{", "}"],
		["[", "]"],
		["(", ")"]
	],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "/*", "close": " */" }
	],
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"]
	]
}
