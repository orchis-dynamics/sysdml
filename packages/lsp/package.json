{
	"name": "@sysdml/lsp-server",
	"version": "0.1.2",
	"license": "AGPL-3.0-only",
	"bin": {
		"sysdml-lsp": "./dist/src/server.js"
	},
	"files": [
		"dist/src",
		"LICENSE"
	],
	"type": "module",
	"main": "./dist/src/server.js",
	"types": "./dist/src/server.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/server.d.ts",
			"default": "./dist/src/server.js"
		},
		"./browser": {
			"types": "./dist/src/server-browser.d.ts",
			"default": "./dist/src/server-browser.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "rm -rf dist node_modules",
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@sysdml/contracts": "workspace:*",
		"@sysdml/ir": "workspace:*",
		"@sysdml/layout": "workspace:*",
		"@sysdml/parser": "workspace:*",
		"vscode-languageserver": "^9.0.0",
		"vscode-languageserver-textdocument": "^1.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"typescript": "^5.4.5",
		"vitest": "^4.1.5"
	}
}
