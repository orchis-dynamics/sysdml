		"./syntax": { "types": "./dist/src/syntax/index.d.ts", "default": "./dist/src/syntax/index.js" },
		"./diagnostics": { "types": "./dist/src/diagnostics/index.d.ts", "default": "./dist/src/diagnostics/index.js" },
		"./model": { "types": "./dist/src/model/index.d.ts", "default": "./dist/src/model/index.js" },
		"./simulation": { "types": "./dist/src/simulation/index.d.ts", "default": "./dist/src/simulation/index.js" },
