{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": ".",
		"outDir": "./dist/types-check",
		"strict": true,
		"declaration": true,
		"declarationMap": false,
		"emitDeclarationOnly": true,
		"sourceMap": false,
		"esModuleInterop": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src/**/*", "tests/**/*"]
}
