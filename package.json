{
	"name": "sysdml",
	"version": "0.1.0",
	"private": true,
	"description": "SysDML monorepo — system dynamics modeling language",
	"license": "AGPL-3.0-only",
	"scripts": {
		"build": "pnpm -r build",
		"test": "pnpm -r test",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"update-simlin": "bash scripts/update-simlin.sh",
		"clean": "pnpm -r clean && rm -rf node_modules",
		"changeset": "changeset",
		"version-packages": "changeset version"
	},
	"devDependencies": {
		"@changesets/cli": "2.31.0",
		"oxfmt": "^0.47.0",
		"oxlint": "^1.62.0",
		"oxlint-tsgolint": "^0.22.1"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=9"
	},
	"packageManager": "pnpm@9.6.0",
	"pnpm": {
		"overrides": {
			"undici": ">=7.28.0 <8",
			"form-data": ">=4.0.6"
		}
	}
}
